{
  "name": "fullstack-app",
  "private": true,
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "dev:frontend": "npm -w apps/frontend run dev",
    "dev:backend": "npm -w apps/backend run dev",
    "build:frontend": "npm -w apps/frontend run build",
    "build": "npm run build:frontend",
    "start:backend": "npm -w apps/backend run start",
    "start": "npm run start:backend",
    "test:frontend": "npm -w apps/frontend run test"
  }
}
